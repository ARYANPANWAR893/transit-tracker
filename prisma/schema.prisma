// KM Sourcing — Sourcing Control Tower
//
// Core shape: Requirement -> Procurement -> Allocation -> Container -> Receipt.
// A requirement's quantity may be split across several containers, so quantities
// live in their own records and totals are DERIVED (see lib/quantities.ts) rather
// than stored as one linear status that could drift from reality.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN                 // Aryan   — control tower: full visibility, override, audit
  REQUIREMENT_OWNER     // Ruhi    — raises requirements, confirms receipt
  PROCUREMENT_OWNER     // Anish   — confirms procurement, allocates into containers
  SOURCING_COORDINATOR  // Panda   — uploads manifests, reviews exceptions
  LOADING_COORDINATOR   // Alice   — confirms loading
}

/// Only the states a human explicitly decides. Everything downstream
/// (allocated / shipped / received) is derived from quantities.
enum RequirementStatus {
  REQUESTED
  REJECTED
  WITHDRAWN
}

enum ContainerStatus {
  CREATED
  PROCUREMENT
  READY_FOR_LOADING
  LOADING
  LOADED
  IN_TRANSIT
  ARRIVED
}

enum ContainerUploadStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ContainerItemMatchStatus {
  MATCHED
  AMBIGUOUS
  UNMATCHED
  ERROR
}

enum PhotoSource {
  REQUIREMENT_UPLOAD
  CONTAINER_IMPORT
}

/// No identifier is privileged: a manifest code resolves against all of these.
enum IdentifierType {
  KMW
  KATTYMAO_SKU
  MA_SKU
  CHINA_CODE
  AMAZON_SKU
  AMAZON_ASIN
  FLIPKART_SKU
  FLIPKART_ASIN
  MEESHO_SKU
  MEESHO_PRODUCT_ID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(REQUIREMENT_OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessions Session[]

  requirementsCreated   Requirement[] @relation("RequirementCreatedBy")
  requirementsRejected  Requirement[] @relation("RequirementRejectedBy")
  requirementsWithdrawn Requirement[] @relation("RequirementWithdrawnBy")

  procurements     Procurement[]
  allocations      Allocation[]
  receipts         Receipt[]
  containersCreated Container[]

  remarks              Remark[]
  photosUploaded       Photo[]
  containerUploads     ContainerUpload[]
  containerItemReviews ContainerItem[]
  activityLogs         ActivityLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ProductFamily {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The canonical product record. Every external code lives in ProductIdentifier
/// so no single marketplace/ERP field is hard-coded as "the truth".
model Product {
  id       String         @id @default(cuid())
  name     String
  familyId String?
  family   ProductFamily? @relation(fields: [familyId], references: [id])

  identifiers  ProductIdentifier[]
  requirements Requirement[]
  containerItems ContainerItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
}

model ProductIdentifier {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      IdentifierType
  value     String
  /// Upper-cased, punctuation-stripped form used for manifest resolution.
  normalizedValue String

  createdAt DateTime @default(now())

  @@unique([productId, type, value])
  @@index([normalizedValue])
  @@index([productId])
}

model Requirement {
  id     String            @id @default(cuid())
  status RequirementStatus @default(REQUESTED)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  requiredQty  Int
  requestedDate DateTime @default(now())
  neededByDate DateTime

  createdById String
  createdBy   User   @relation("RequirementCreatedBy", fields: [createdById], references: [id])

  rejectionReason String?
  rejectedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?     @relation("RequirementRejectedBy", fields: [rejectedById], references: [id])

  withdrawnAt   DateTime?
  withdrawnById String?
  withdrawnBy   User?     @relation("RequirementWithdrawnBy", fields: [withdrawnById], references: [id])

  procurements Procurement[]
  allocations  Allocation[]
  remarks      Remark[]
  photos       Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([productId])
  @@index([createdById])
}

/// Anish confirming that some quantity of a requirement has been procured.
/// Several rows may partially fulfil one requirement.
model Procurement {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  qty           Int
  confirmedById String
  confirmedBy   User     @relation(fields: [confirmedById], references: [id])
  confirmedAt   DateTime @default(now())
  notes         String?

  @@index([requirementId])
}

/// The Product <-> Container relationship both flagship views read from.
model Allocation {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  containerId   String
  container     Container   @relation(fields: [containerId], references: [id], onDelete: Cascade)

  qty           Int
  allocatedById String
  allocatedBy   User     @relation(fields: [allocatedById], references: [id])
  allocatedAt   DateTime @default(now())

  receipts Receipt[]

  @@index([requirementId])
  @@index([containerId])
}

/// Partial receipt is supported: an allocation may be received in instalments.
model Receipt {
  id           String     @id @default(cuid())
  allocationId String
  allocation   Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  qty           Int
  confirmedById String
  confirmedBy   User     @relation(fields: [confirmedById], references: [id])
  confirmedAt   DateTime @default(now())

  @@index([allocationId])
}

model Container {
  id   String @id @default(cuid())
  /// Normalised on write ("YS 15" / "ys15" -> "YS15") so one container can't exist twice.
  code String @unique

  loadingDate         DateTime?
  /// Derived from loadingDate via lib/shipping.ts; stored so it is sortable/filterable.
  expectedArrivalDate DateTime?
  status              ContainerStatus @default(CREATED)
  notes               String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  allocations Allocation[]
  items       ContainerItem[]
  uploads     ContainerUpload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// An ingestion event: one packing-list file processed against a container.
model ContainerUpload {
  id          String    @id @default(cuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  fileName String
  blobUrl  String
  status   ContainerUploadStatus @default(PROCESSING)

  totalRows      Int @default(0)
  matchedCount   Int @default(0)
  ambiguousCount Int @default(0)
  unmatchedCount Int @default(0)
  errorCount     Int @default(0)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  errorMessage String?

  items ContainerItem[]

  createdAt DateTime @default(now())

  @@index([containerId])
  @@index([uploadedById])
}

model ContainerItem {
  id          String    @id @default(cuid())
  containerId String
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  /// Provenance: which upload produced this row.
  containerUploadId String?
  containerUpload   ContainerUpload? @relation(fields: [containerUploadId], references: [id], onDelete: SetNull)

  rowNumber    Int
  shippingMark String?
  itemNo       String?
  description  String?
  sectionLabel String?

  cartons      Int?
  qtyPerCarton Int?
  totalQty     Int?
  cbm          Decimal? @db.Decimal(12, 4)
  totalCbm     Decimal? @db.Decimal(12, 4)
  weight       Decimal? @db.Decimal(12, 4)
  totalWeight  Decimal? @db.Decimal(12, 4)

  imageUrl String?

  matchStatus ContainerItemMatchStatus
  matchNote   String?

  /// Resolved via ProductIdentifier, not via any single hard-coded SKU field.
  resolvedProductId String?
  resolvedProduct   Product? @relation(fields: [resolvedProductId], references: [id])

  reviewedById String?
  reviewedBy   User?     @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([containerId])
  @@index([containerUploadId])
  @@index([resolvedProductId])
  @@index([matchStatus])
}

model Remark {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  body     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requirementId])
}

model Photo {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  url          String
  blobPathname String
  source       PhotoSource @default(REQUIREMENT_UPLOAD)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([requirementId])
}

model ActivityLog {
  id String @id @default(cuid())

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id])
  actorRole Role?

  action     String
  entityType String
  entityId   String?

  previousValue Json?
  newValue      Json?
  remarks       String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
