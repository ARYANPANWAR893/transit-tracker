// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum OrderStatus {
  REQUESTED
  ACCEPTED
  PARTIALLY_ARRIVED
  ARRIVED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  sessions        Session[]
  ordersCreated   Order[]        @relation("OrderCreatedBy")
  arrivalsLogged  OrderArrival[]
  remarks         Remark[]
  photosUploaded  Photo[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ProductFamily {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id       String         @id @default(cuid())
  name     String
  maSku    String         @unique
  kmSku    String         @unique
  familyId String?
  family   ProductFamily? @relation(fields: [familyId], references: [id])
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
}

model Order {
  id              String      @id @default(cuid())
  status          OrderStatus @default(REQUESTED)

  productId       String
  product         Product     @relation(fields: [productId], references: [id])

  qty             Int
  requestedDate   DateTime
  neededByDate    DateTime

  acceptanceDate  DateTime?
  containerNumber String?
  estArrivalDate  DateTime?

  createdById     String
  createdBy       User        @relation("OrderCreatedBy", fields: [createdById], references: [id])

  arrivals        OrderArrival[]
  remarks         Remark[]
  photos          Photo[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([productId])
}

model OrderArrival {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  qty             Int
  arrivedDate     DateTime
  containerNumber String?

  recordedById    String
  recordedBy      User     @relation(fields: [recordedById], references: [id])

  createdAt       DateTime @default(now())

  @@index([orderId])
}

model Remark {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  body      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

model Photo {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  url          String
  blobPathname String

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  createdAt    DateTime @default(now())

  @@index([orderId])
}
